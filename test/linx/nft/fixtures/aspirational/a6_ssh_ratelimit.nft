#!/usr/sbin/nft -f
# Fail2ban-style SSH rate limiting via dynamic sets (nft_dynset).
flush ruleset

table inet fail2ban {
	set ratelimit {
		type ipv4_addr
		flags dynamic, timeout
		timeout 10m
	}

	chain input {
		type filter hook input priority filter; policy accept;
		tcp dport 22 ct state new add @ratelimit { ip saddr limit rate over 3/minute } drop
		tcp dport 22 ct state new update @ratelimit { ip saddr timeout 5m } accept
	}
}
