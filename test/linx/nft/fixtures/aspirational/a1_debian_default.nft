#!/usr/sbin/nft -f
# Debian's stock /etc/nftables.conf (pkg-netfilter-team/pkg-nftables).
flush ruleset

table inet filter {
	chain input {
		type filter hook input priority filter;
	}
	chain forward {
		type filter hook forward priority filter;
	}
	chain output {
		type filter hook output priority filter;
	}
}
