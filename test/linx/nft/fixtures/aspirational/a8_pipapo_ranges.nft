#!/usr/sbin/nft -f
# Service CIDR dispatch with pipapo interval concatenations —
# the kube-proxy / enterprise-allowlist shape.
flush ruleset

table inet svc_ranges {
	set allowed {
		type ipv4_addr . inet_service
		flags interval
		elements = {
			10.0.0.0/24 . 80-443,
			10.96.0.0/16 . 53,
			192.168.1.5 . 8000-9000
		}
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		iif "lo" accept
		ip daddr . tcp dport @allowed counter accept
	}
}
