#!/usr/sbin/nft -f
# Concatenated keys and dynamic sets, knftables/kube-proxy style.
flush ruleset

table inet kube {
	set svc_endpoints {
		type ipv4_addr . inet_service
		elements = { 10.96.0.1 . 443, 10.96.0.10 . 53 }
	}

	set ratelimit {
		type ipv4_addr
		flags dynamic, timeout
		timeout 1m
	}

	chain input {
		type filter hook input priority filter; policy accept;
		ip daddr . tcp dport @svc_endpoints counter accept
		tcp dport 22 ct state new add @ratelimit { ip saddr limit rate 6/minute } accept
	}
}
