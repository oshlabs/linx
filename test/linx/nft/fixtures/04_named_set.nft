# 04 — named set with elements + interval flag
# Set blocklist holds a mix of a single address and a CIDR (interval
# semantics in kernel). Rule references the set via @blocklist.
# Reference: https://wiki.nftables.org/wiki-nftables/index.php/Sets

table inet filter {
  set blocklist {
    type ipv4_addr
    flags interval
    elements = { 10.0.0.1, 192.168.0.0/24 }
  }

  chain input {
    type filter hook input priority 0
    policy accept

    ip saddr @blocklist drop
  }
}
