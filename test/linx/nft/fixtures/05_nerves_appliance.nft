# 05 — Linx Nerves firewall appliance shape
# The pattern from docs/netfilter/EXAMPLES.md ("Nerves firewall
# appliance"), adapted to features the compiler supports today
# (log prefix + group, ct-state accept, CIDR allow, counter drop).

table inet appliance {
  chain input {
    type filter hook input priority 0
    policy drop

    ct state established accept
    meta iifname "lo" accept
    tcp dport 22 log prefix "ssh-attempt" group 5000 accept
    ip saddr 10.0.0.0/8 accept
    counter drop
  }

  chain forward {
    type filter hook forward priority 0
    policy drop
  }

  chain output {
    type filter hook output priority 0
    policy accept
  }
}
