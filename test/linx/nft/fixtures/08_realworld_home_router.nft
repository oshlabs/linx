# 08 — real-world home-router shape
# Anonymized from a real /etc/nftables.conf for a Linux home
# router with VLAN segmentation, WireGuard, PPPoE WAN, and IPv6.
# Addresses / prefixes / interfaces have been replaced with
# documentation-range / generic values:
#
#   * Documentation IPv4 prefix:  192.0.2.0/24 (RFC 5737)
#   * Documentation IPv6 prefix:  2001:db8::/32 (RFC 3849)
#   * ULA prefix:                 fd00::/48 (RFC 4193 range)
#   * Generic interface names (eth0/eth0.10/wg0/ppp0)
#
# This fixture exercises the features added in N8g–N8j:
#   * `flush ruleset` at the top  (N8j)
#   * `iifname` / `oifname` bare shorthand  (N8g)
#   * `ct state { … }` inline-set match  (N8h)
#   * `ct state established,related` comma-no-braces form  (N8h)
#   * `icmpv6 type { echo-request, … }` symbolic ICMPv6 names  (N8i)
#
# …plus the older N8a–N8f core: tables in three families, base
# chains with policy / hooks / priorities, multi-VLAN dispatch
# via inline-set iifname, line-continuation in a long rule,
# per-rule `comment "…"`, NAT prerouting / postrouting with
# masquerade, IPv6 CIDR matching.

flush ruleset

table inet filter {
  chain input {
    type filter hook input priority 0
    policy drop

    # allow established/related connections
    ct state { established, related } accept

    # early drop of invalid connections
    ct state invalid drop

    # allow all from loopback
    iifname "lo" accept

    # Allow all from internal network (multi-VLAN inline set)
    iifname { "eth0.10", "eth0.13", "eth0.100", "eth0.101" } accept

    # Allow all from wireguard
    iifname "wg0" accept

    # Allow ICMPv6 essential types — neighbour discovery + path MTU
    icmpv6 type {
      echo-request, echo-reply,
      destination-unreachable, packet-too-big,
      time-exceeded, parameter-problem,
      nd-router-solicit, nd-router-advert,
      nd-neighbor-solicit, nd-neighbor-advert,
      redirect
    } accept

    # Allow inbound DHCPv6 replies
    iifname "ppp0" udp dport 546 accept comment "Allow inbound DHCPv6 replies"

    # Allow outbound DHCPv6 requests
    oifname "ppp0" udp dport 547 accept comment "Allow outbound DHCPv6 requests"

    # allow icmp
    ip protocol icmp accept

    # allow wireguard over non-default udp port
    udp dport 65431 accept comment "wireguard in"

    # IoT VLAN gets DNS + DHCPv4 from this gateway
    iifname "eth0.15" udp dport 53 accept comment "DNS (udp) from IoT"
    iifname "eth0.15" tcp dport 53 accept comment "DNS (tcp) from IoT"
    iifname "eth0.15" udp dport 67 accept comment "DHCPv4 from IoT"

    reject
  }

  chain forward {
    type filter hook forward priority 0
    policy drop

    # comma-no-braces form on this one to exercise the parser path
    ct state established,related accept

    # LAN → WAN
    iifname { "eth0.10", "eth0.13", "eth0.15", "eth0.100", "eth0.101" } oifname "ppp0" accept

    # LAN ↔ LAN / WG ↔ LAN — single rule split across two source
    # lines using nft's `\` continuation (the tokenizer eats it
    # silently).
    iifname { "wg0", "eth0.10", "eth0.13", "eth0.100", "eth0.101" } \
    oifname { "wg0", "eth0.10", "eth0.13", "eth0.15", "eth0.100", "eth0.101" } accept

    # Allow ICMPv6 errors through (PMTU etc., for safety)
    icmpv6 type {
      destination-unreachable,
      packet-too-big,
      time-exceeded,
      parameter-problem
    } accept
  }

  chain output {
    type filter hook output priority 0
    policy accept
  }
}

table ip nat {
  chain prerouting {
    type nat hook prerouting priority 0
  }

  chain postrouting {
    type nat hook postrouting priority 0

    # Masquerade outgoing traffic to internet
    oifname "ppp0" masquerade
  }
}
