# 07 — host-side firewall governing a container's veth peer
# Adapted from the "container lock-down composition" in EXAMPLES.md.
# Mixes interface-name matches with payload matches on the same
# rule — the kernel chains the expressions sequentially, the
# formatter renders each `meta + cmp` and `payload + cmp` pair as
# its natural source form.

table inet container_guard {
  chain input {
    type filter hook input priority 0
    policy drop

    ct state established accept
    meta iifname "ct0a" tcp dport 80 accept
    meta iifname "ct0a" drop
  }

  chain forward {
    type filter hook forward priority 0
    policy drop

    ct state established accept
    meta iifname "ct0a" tcp dport { 80, 443 } accept
  }
}
